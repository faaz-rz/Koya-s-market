# Public Flutter compile-time configuration (safe to ship in the app).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
PRIVACY_POLICY_URL=https://YOUR_PUBLIC_DOMAIN/privacy
ACCOUNT_DELETION_URL=https://YOUR_PUBLIC_DOMAIN/delete-account
ENABLE_PLAY_REVIEW_LOGIN=true
ADMIN_IDLE_TIMEOUT_MINUTES=15

# Reserved later-release Edge Function secrets (never pass these to Flutter).
# None of these are required for the first cash/UPI-at-handover release.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
KOYAS_WEBHOOK_SECRET=replace_with_a_long_random_value
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
