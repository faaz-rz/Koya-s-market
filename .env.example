# Public Flutter compile-time configuration (safe to ship in the app).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_RAZORPAY_PAYMENTS=false
ADMIN_IDLE_TIMEOUT_MINUTES=15

# Supabase Edge Function secrets (never pass these to Flutter).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
KOYAS_WEBHOOK_SECRET=replace_with_a_long_random_value
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
